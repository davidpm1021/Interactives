{
  "name": "ngpf-interactives",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "feature": "bash create-feature.sh",
    "production": "ng build --configuration production",
    "parse-dictionary": "npx ts-node --project tsconfig.scripts.json --esm scripts/ngpf-vocabulary-flashcards/parse-dictionary.ts",
    "audit-dictionary": "npx ts-node --project tsconfig.scripts.json --esm scripts/ngpf-vocabulary-flashcards/audit-dictionary.ts",
    "validate-dictionary": "npx ts-node --project tsconfig.scripts.json --esm scripts/ngpf-vocabulary-flashcards/validate-dictionary.ts",
    "sync-dictionary": "npx ts-node --project tsconfig.scripts.json --esm scripts/ngpf-vocabulary-flashcards/sync-dictionary.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "@types/node": "^25.2.3",
    "googleapis": "^171.2.0",
    "jsdom": "^27.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
